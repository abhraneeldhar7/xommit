---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/navBar.tsx";
import Hero from "../components/sections/Hero.tsx";
import StagedFiles from "../components/sections/StagedFiles.tsx";
import ZeroPayments from "../components/sections/ZeroPayments.tsx";
import GithubRepoCommits from "../components/sections/GithubRepoCommits.tsx";
import OtherWaysToInstall from "../components/sections/OtherWaysToInstall.tsx";
import FAQ from "../components/sections/FAQ.tsx";
import HowAiWasUsed from "../components/sections/HowAIwasUsed.tsx";
import Footer from "../components/sections/Footer.tsx";
import { getCliVersion } from "../lib/version";

const version = getCliVersion();
---

<Layout>
	<NavBar />
	<div class="w-full pt-30 px-4 md:px-15 relative">
		<Hero client:load version={version} />
		<StagedFiles />
		<ZeroPayments />
		<GithubRepoCommits client:load />
		<OtherWaysToInstall client:load version={version} />
		<FAQ />
		<HowAiWasUsed />
		<Footer />
	</div>
</Layout>
