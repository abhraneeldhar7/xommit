---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/navBar.tsx";
import Hero from "../components/sections/Hero.tsx";
import StagedFiles from "../components/sections/StagedFiles.astro";
import ZeroPayments from "../components/sections/ZeroPayments.astro";
import GithubRepoCommits from "../components/sections/GithubRepoCommits.astro";
import OtherWaysToInstall from "../components/sections/OtherWaysToInstall.tsx";
import FAQ from "../components/sections/FAQ.astro";
import HowAiWasUsed from "../components/sections/HowAIwasUsed.astro";
import Footer from "../components/sections/Footer.astro";
import { getCliVersion } from "../lib/version";

const version = getCliVersion();
---

<Layout>
	<NavBar client:load />
	<main class="w-full pt-30 px-4 md:px-15 relative">
		<Hero client:load version={version} />
		<StagedFiles />
		<ZeroPayments />
		<GithubRepoCommits />
		<OtherWaysToInstall client:load version={version} />
		<FAQ />
		<HowAiWasUsed />
	</main>
	<Footer />
</Layout>
