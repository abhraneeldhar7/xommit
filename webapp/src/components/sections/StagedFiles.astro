---
import { Image } from "astro:assets"
import { ChevronDown, FileIcon, LockIcon } from "lucide-react"
import Gradient from "../../assets/gradient.webp"

const stagedFiles = [
    "src/auth/token_refresh.rs",
    "services/payment/stripe_webhook.py",
    "internal/cache/redis_pool.go",
    "db/migrations/0042_add_user_preferences.sql",
    "pkg/logger/structured_logging.rs",
]

const changesFiles = [
    "src/auth/token_refresh.rs",
    "services/payment/stripe_webhook.py",
    "internal/cache/redis_pool.go",
    "tests/auth/token_refresh_test.rs",
    "docs/api/payment_webhook.md",
]
---

<section aria-labelledby="how-it-works-heading" class="my-15 site-max flex gap-10 md:flex-row flex-col">

    <div class="md:flex-1 md:sticky top-[100px] md:self-start">
        <h2 id="how-it-works-heading" class="text-4xl">How it works</h2>
        <p class="md:text-md text-muted-foreground mt-4 leading-[1.8em]">Xommit reads the diffs you have staged and sends them to your LLM along with the conventional commit rules, the same conventions that keep a commit history readable years later. It comes back with three messages written for that diff. You pick the one that fits, and xommit commits it for you. Nothing outside <span class="text-foreground/80 font-[500]">Staged</span> is ever read, and your index is never touched.</p>
    </div>

    <div class="md:flex-1 aspect-square">
        <div class="rounded-md h-full w-full relative overflow-hidden flex flex-col flex-1">
            <Image src={Gradient} alt="" class="w-full h-full top-0 left-0 absolute object-cover z-[-1] " />

            <div class="w-full h-full flex items-center p-5 md:p-15">

                <div class="w-full h-fit rounded-md bg-background/70 p-3 px-5">

                    <p class="">Staged <ChevronDown size={17} className="inline opacity-70" /></p>
                    <div class="mt-2 space-y-2.5">
                        {stagedFiles.map((file, i) => (
                            <div class="flex gap-2 items-center">
                                <FileIcon size={17} className="opacity-80" />
                                <p class="text-md truncate w-full leading-[1.1em] text-muted-foreground shimmer font-[500]" style={`animation-delay: ${i * 100}ms`}>
                                    {file}
                                </p>
                            </div>
                        ))}
                    </div>

                    <p class="mt-5">Changes <ChevronDown size={17} className="inline opacity-70" /></p>
                    <div class="mt-2 space-y-2.5 relative">

                        <div class="blur-[4px] space-y-2 opacity-60">
                            {changesFiles.map((file, i) => (
                                <div class="flex gap-2 items-center">
                                    <FileIcon size={17} className="opacity-80" />
                                    <p class="text-md truncate w-full leading-[1.1em] text-muted-foreground" style={`animation-delay: ${i * 100}ms`}>
                                        {file}
                                    </p>
                                </div>
                            ))}
                        </div>
                        <div class="absolute top-0 left-0 flex items-center justify-center w-full h-full">
                            <p class="text-center text-lg font-">
                                Untouched <LockIcon size={18} strokeWidth={2.5} className="inline mb-1 ml-1 opacity-90" />
                            </p>
                        </div>
                    </div>


                </div>

            </div>

        </div>
    </div>

</section>
