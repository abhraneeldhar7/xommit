---
import { Image } from "astro:assets"
import Gradient from "../../assets/gradient.webp"
import TerminalConnect from "@/components/TerminalConnect.tsx"
---

<section aria-labelledby="zero-payment-heading" class="my-15 md:my-30 site-max flex gap-10 md:flex-row-reverse flex-col">

    <div class="md:flex-1 md:self-start md:text-right">
        <h2 id="zero-payment-heading" class="text-4xl">Zero Payment</h2>
        <p class="md:text-md text-muted-foreground mt-4 leading-[1.8em]">Chances are you have free credits sitting in a provider you already signed up for, and a commit message costs almost nothing to generate. Point xommit at those credits and let it handle committing for you. No monthly fee, nothing to pay me, and one less thing on your mind.</p>
    </div>

    <div class="md:flex-1">
        <div class="rounded-md h-full w-full relative overflow-hidden">
            <Image src={Gradient} alt="" class="w-full h-full top-0 left-0 absolute object-cover z-[-1]" />

            <div class="h-full w-full p-5 md:p-10 flex items-center">
                <TerminalConnect />
            </div>

        </div>
    </div>

</section>
