  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhraneeldhar7/xommit.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "abhraneeldhar7",
  "type": "commonjs",
  "bin": {
    "xommit": "scripts/index.js"
  },
  "files": [
